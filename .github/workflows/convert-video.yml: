name: Convert MP4 to MPD (MPEG-DASH)

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  mpeg-dash-conversion:
    runs-on: ubuntu-latest

    steps:
    # 1. Ambil file video dari repositori Anda
    - name: Checkout Repository
      uses: actions/checkout@v4

    # 2. Pasang FFmpeg langsung ke dalam server Ubuntu
    - name: Install FFmpeg Tools
      run: |
        sudo apt-get update
        sudo apt-get install -y ffmpeg

    # 3. Proses konversi video MP4 menjadi manifes MPD beserta segmennya
    # Pastikan file 'video-input.mp4' ada di root direktori repositori Anda atau ubah namanya sesuai file Anda
    - name: Process Video Encoding
      run: |
        mkdir -p dash-output
        ffmpeg -i iklan.mp4 -c:v copy -c:a copy -f dash dash-output/stream.mpd

    # 4. Simpan folder hasil ekspor agar bisa diunduh langsung
    - name: Save DASH Output Artifacts
      uses: actions/upload-artifact@v4
      with:
        name: dash-stream-package
        path: dash-output/
