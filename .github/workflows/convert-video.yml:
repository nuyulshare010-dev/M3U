name: Murni Convert MP4 ke MPD

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  proses-mpd:
    runs-on: ubuntu-latest

    steps:
    # 1. Ambil file video dari repo lu
    - name: Ambil Kode Repo
      uses: actions/checkout@v4

    # 2. Install FFmpeg murni (Tanpa Java, Tanpa Gradle, Tanpa Android)
    - name: Pasang FFmpeg Tools
      run: |
        sudo apt-get update
        sudo apt-get install -y ffmpeg

    # 3. Proses konversi MP4 ke MPD
    # PENTING: Ganti 'video-input.mp4' dengan nama file video asli lu yang ada di repo
    - name: Eksekusi FFmpeg ke MPD
      run: |
        mkdir -p hasil-dash
        ffmpeg -i iklan.mp4 -c:v copy -c:a copy -f dash hasil-dash/stream.mpd

    # 4. Upload hasilnya biar bisa lu download berupa ZIP
    - name: Simpan Paket MPD
      uses: actions/upload-artifact@v4
      with:
        name: paket-video-mpd
        path: hasil-dash/
