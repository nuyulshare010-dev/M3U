name: Convert MP4 to MPD (MPEG-DASH)

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  convert-video:
    runs-on: ubuntu-latest

    steps:
    # 1. Ambil file video dari repo
    - name: Checkout Repository
      uses: actions/checkout@v4

    # 2. Install FFmpeg aja, gak pake Java, gak pake Gradle
    - name: Install FFmpeg
      run: |
        sudo apt-get update
        sudo apt-get install -y ffmpeg

    # 3. Proses konversi video
    # JANGAN LUPA: Ganti 'video-input.mp4' dengan nama file video asli di repo Anda
    - name: Convert MP4 to MPD via FFmpeg
      run: |
        mkdir -p dash-output
        ffmpeg -i iklan.mp4 -c:v copy -c:a copy -f dash dash-output/stream.mpd

    # 4. Bungkus hasilnya jadi ZIP biar bisa didownload
    - name: Upload DASH Artifacts
      uses: actions/upload-artifact@v4
      with:
        name: dash-video-package
        path: dash-output/
