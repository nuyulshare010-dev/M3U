name: Murni Convert MP4 ke MPD

on:
  workflow_dispatch: # Hanya dijalankan manual lewat tombol di web, biar gak memicu push APK lama

jobs:
  proses-mpd:
    runs-on: ubuntu-latest

    steps:
    # 1. Tarik file dari repositori lu
    - name: Ambil File Repo
      uses: actions/checkout@v4

    # 2. Pasang FFmpeg (Murni tanpa Java, tanpa Gradle)
    - name: Pasang FFmpeg Tools
      run: |
        sudo apt-get update
        sudo apt-get install -y ffmpeg

    # 3. Proses konversi MP4 ke MPD
    # PENTING: Ganti 'video-input.mp4' dengan nama file video asli lu yang ada di repo
    - name: Eksekusi FFmpeg ke MPD
      run: |
        mkdir -p hasil-dash
        ffmpeg -i iklan.mp4 -c:v copy -c:a copy -f dash hasil-dash/stream.mpd

    # 4. Upload folder hasil konversi biar bisa lu download berupa ZIP
    - name: Simpan Paket MPD
      uses: actions/upload-artifact@v4
      with:
        name: paket-video-mpd
        path: hasil-dash/
